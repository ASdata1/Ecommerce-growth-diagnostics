	column git_commit
		dataType: string
		lineageTag: 458f52a2-c2b1-477c-87ea-9943bd88f49f
		summarizeBy: none
		sourceColumn: git_commit

		annotation SummarizationSetBy = Automatic

	column 'Feature Type' =
			SWITCH(
			    TRUE(),
			    LEFT(repeat_purchase_odds_ratios[feature], 15) = "customer_state_", "Customer state",
			    LEFT(repeat_purchase_odds_ratios[feature], 17) = "product_category_", "Product category",
			    LEFT(repeat_purchase_odds_ratios[feature], 13) = "payment_type_", "Payment type",
			    "Other"
			)
		dataType: string
		displayFolder: Model
		lineageTag: 336b5cfb-80e4-496d-86fb-328e3b860069
		summarizeBy: none

	column 'Feature Label' =
			VAR RawFeature = repeat_purchase_odds_ratios[feature]
			VAR NoPrefix =
			    SWITCH(
			        TRUE(),
			        LEFT(RawFeature, 15) = "customer_state_", MID(RawFeature, 16, 100),
			        LEFT(RawFeature, 17) = "product_category_", MID(RawFeature, 18, 100),
			        LEFT(RawFeature, 13) = "payment_type_", MID(RawFeature, 14, 100),
			        RawFeature
			    )
			VAR Spaced = TRIM(SUBSTITUTE(NoPrefix, "_", " "))
			VAR PathText = SUBSTITUTE(Spaced, " ", "|")
			VAR WordCount = PATHLENGTH(PathText)
			VAR W1 = PATHITEM(PathText, 1)
			VAR W2 = IF(WordCount >= 2, PATHITEM(PathText, 2), "")
			VAR W3 = IF(WordCount >= 3, PATHITEM(PathText, 3), "")
			VAR W4 = IF(WordCount >= 4, PATHITEM(PathText, 4), "")
			VAR Cap1 = UPPER(LEFT(W1, 1)) & LOWER(MID(W1, 2, 100))
			VAR Cap2 = IF(W2 = "", "", UPPER(LEFT(W2, 1)) & LOWER(MID(W2, 2, 100)))
			VAR Cap3 = IF(W3 = "", "", UPPER(LEFT(W3, 1)) & LOWER(MID(W3, 2, 100)))
			VAR Cap4 = IF(W4 = "", "", UPPER(LEFT(W4, 1)) & LOWER(MID(W4, 2, 100)))
			RETURN
			TRIM(Cap1 & " " & Cap2 & " " & Cap3 & " " & Cap4)
		dataType: string
		displayFolder: Model
		lineageTag: 63a6102a-d972-4de6-9f47-8ce5adaeccb4
		summarizeBy: none

