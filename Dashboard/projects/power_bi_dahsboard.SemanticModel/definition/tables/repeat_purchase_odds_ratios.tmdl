table repeat_purchase_odds_ratios
	lineageTag: e65f7535-9cb9-431e-b42f-2b5c90e69cf4

	measure 'Odds Ratio Color' = IF(SELECTEDVALUE(repeat_purchase_odds_ratios[odds_ratio]) >= 1, "#2A78D6", "#E34948")
		displayFolder: Model
		lineageTag: 2782fd8e-48b1-49c3-9b94-55b4b00ee94a

	measure 'Odds Ratio Show Row' =
			
			VAR SelectedN = SELECTEDVALUE('Top Bottom N'[N Value], 5)
			VAR CurrentOR = SELECTEDVALUE(repeat_purchase_odds_ratios[odds_ratio])
			VAR HigherRank =
			    RANKX(FILTER(ALLSELECTED(repeat_purchase_odds_ratios), repeat_purchase_odds_ratios[odds_ratio] >= 1), repeat_purchase_odds_ratios[odds_ratio], CurrentOR, DESC, DENSE)
			VAR LowerRank =
			    RANKX(FILTER(ALLSELECTED(repeat_purchase_odds_ratios), repeat_purchase_odds_ratios[odds_ratio] < 1), repeat_purchase_odds_ratios[odds_ratio], CurrentOR, ASC, DENSE)
			RETURN
			IF(
			    SelectedN >= 999 ||
			    (CurrentOR >= 1 && HigherRank <= SelectedN) ||
			    (CurrentOR < 1 && LowerRank <= SelectedN),
			    1
			)
		formatString: 0
		isHidden
		displayFolder: Model
		lineageTag: e5f60be3-c578-4e7a-a958-7a382934c4bc

	column feature
		dataType: string
		lineageTag: 74a28ad4-fbba-487d-9571-64d3bb021df4
		summarizeBy: none
		sourceColumn: feature

		annotation SummarizationSetBy = Automatic

	column coefficient
		dataType: double
		lineageTag: 37932501-7d82-4b47-8249-eb57e2e30f9f
		summarizeBy: sum
		sourceColumn: coefficient

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column odds_ratio
		dataType: double
		lineageTag: a1365580-d8a3-4156-9ed0-b22fc4530268
		summarizeBy: sum
		sourceColumn: odds_ratio

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column abs_coefficient
		dataType: double
		lineageTag: 4cd5a51b-c1a0-48ca-8f08-145efae0cf44
